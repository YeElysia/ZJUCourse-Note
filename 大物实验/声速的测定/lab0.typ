$
  u_B (lambda) & = Delta_仪/sqrt(3) = (0.01 "mm")/sqrt(3) = 0.005 "mm" \
       u_B (f) & = Delta_仪/sqrt(3) = (10 "Hz")/sqrt(3) = 5.77 "Hz" \
$
=== 驻波法误差分析
$
  u_A (lambda_1) & = sqrt(sum((lambda_i - overline(lambda_1))^2)/(n(n-1))) = 0.019 "mm" \
     u(lambda_1) & = sqrt(u_A(lambda_1)^2 + u_B(lambda)^2) = 0.020 "mm" \
$
$
  u_(v 1)/v_1 & = sqrt(((u(lambda_1))/overline(lambda_1))^2 + (u_B(f)/overline(f))^2) = 0.8 \
$
则声速为：$v_1 = (342.7 plus.minus 0.8) quad ("m/s")$
=== 相位差法误差分析
$
  u_A (lambda_2) & = sqrt(sum((lambda_i - overline(lambda_2))^2)/(n(n-1))) = 0.016 "mm" \
